# Copy to .env.local and fill in. Never commit .env.local.
# Every value here is a placeholder — no real secret belongs in this file.

# --- Platform ---
# Apex domain that tenant subdomains hang off, e.g. a site lives at <slug>.<ROOT_DOMAIN>
ROOT_DOMAIN=hordemart.local:3000
# Host serving the seller/admin dashboard. MUST be distinct from any tenant host.
APP_HOST=app.hordemart.local:3000
NODE_ENV=development

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/hordemart
MONGODB_DB=hordemart

# --- Auth ---
# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SECRET=replace-me-with-openssl-rand-base64-48

# --- Paystack (TEST KEYS ONLY until explicitly cleared for production) ---
# The client refuses any key not starting with sk_test_ unless
# HORDEMART_ALLOW_LIVE_KEYS=true is also set. Going live is a deliberate act.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_TIMEOUT_MS=15000
# HORDEMART_ALLOW_LIVE_KEYS=true

# --- Refund policy ---
# Who absorbs the platform commission when an order is refunded.
#   retain              platform keeps its commission; seller funds the refund
#   return_proportional platform returns commission in proportion (default)
#   return_full         platform returns its whole commission, even on a partial
# Paystack's processing fee is never returned under any of these — that is the
# provider's behaviour, not a setting. See docs/adr/0009.
REFUND_COMMISSION_POLICY=return_proportional

# --- Risk controls ---
# Days a newly verified seller must wait before they can accept payments.
# Blocks transacting, never settlement (ADR-0007). 0 disables the hold.
NEW_SELLER_HOLD_DAYS=0

# --- Upstash Redis (rate limiting + webhook idempotency locks) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend ---
RESEND_API_KEY=
EMAIL_FROM=no-reply@hordemart.local

# --- Email (verification mail; optional in development) ---
# EMAIL_FROM=

# --- Public host config for client components (ads host check) ---
NEXT_PUBLIC_ROOT_DOMAIN=

# --- Ads (platform pages only; never on storefronts) ---
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=

# --- Premium subscriptions ---
# The Paystack plan sellers subscribe to (Dashboard > Plans). Its amount must
# equal TIERS.pro.priceKobo in src/config/plans.ts. Unset = Premium not on sale.
PAYSTACK_PREMIUM_PLAN_CODE=
# Where custom-domain and business-email add-on requests go. Unset = the page
# says contact details are being set up.
SALES_CONTACT_EMAIL=
