# Copy to .env.local and fill in. Never commit .env.local.
# Every value here is a placeholder — no real secret belongs in this file.

# --- Platform ---
# Apex domain that tenant subdomains hang off, e.g. a site lives at <slug>.<ROOT_DOMAIN>
ROOT_DOMAIN=hordemart.local:3000
# Host serving the seller/admin dashboard. MUST be distinct from any tenant host.
APP_HOST=app.hordemart.local:3000
NODE_ENV=development

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/hordemart
MONGODB_DB=hordemart

# --- Auth ---
# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SECRET=replace-me-with-openssl-rand-base64-48
# Encryption key for payout account numbers at rest. Generate the same way.
PAYOUT_ENCRYPTION_KEY=replace-me-with-openssl-rand-base64-48

# --- Paystack (TEST KEYS ONLY until explicitly cleared for production) ---
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# --- Upstash Redis (rate limiting + webhook idempotency locks) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend ---
RESEND_API_KEY=
EMAIL_FROM=no-reply@hordemart.local
