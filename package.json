{
  "name": "hordemart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "reconcile": "tsx --env-file=.env.local scripts/reconcile.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "doctor": "tsx --env-file=.env.local scripts/doctor.ts",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "sync-indexes": "tsx --env-file=.env.local scripts/sync-indexes.ts",
    "make-admin": "tsx --env-file=.env.local scripts/make-admin.ts",
    "mrmouse:retry": "tsx --env-file=.env.local scripts/mrmouse-retry.ts",
    "emails:send": "tsx --env-file=.env.local scripts/send-emails.ts"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@node-rs/argon2": "^2.0.2",
    "@puckeditor/core": "0.23.0",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.38.4",
    "gsap": "3.15.0",
    "isomorphic-dompurify": "^2.19.0",
    "mongoose": "^8.9.5",
    "next": "^15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.27",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
